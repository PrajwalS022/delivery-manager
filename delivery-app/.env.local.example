# Copy this file to .env.local and fill in your values
# Do NOT commit .env.local to git (add to .gitignore)

# Supabase Configuration
# Get these from https://supabase.com → Your Project → Settings → API

# Your Supabase project URL
# Example: https://abc123def456.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous (public) key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_YOUR_KEY_HERE

# For development only - set to true to see debug logs
# VITE_DEBUG=true
